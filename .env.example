DATABASE_URL=postgres://user:password@localhost/database
ADMIN_USER=admin@admin.com
ADMIN_PASSWORD=password
# Clave de sesión: al menos 32 bytes; cifra y firma el cookie de sesión.
# Rotarla invalida todas las sesiones (todos los usuarios debian reingresar).
# Generación:
#   openssl rand -hex 32
SESSION_KEY=
APP_ENV=development

# Dirección de escucha del HTTP server. Default seguro: solo loopback.
# Para acceso desde la LAN (sin TLS: solo red de confianza, ver SECURITY.md):
#   BIND_ADDR=0.0.0.0:8080
BIND_ADDR=127.0.0.1:8080
